pragma solidity ^0.8.26;

/// @notice The UltraHonk verifier generated by Barretenberg for the `transact` circuit.
interface IHonkVerifier {
    function verify(bytes calldata proof, bytes32[] calldata publicInputs) external view returns (bool);
}

/// @notice A private balance of one asset (`docs/updates/L3-R2-SPEC.md` 6, Shield V2): notes in a Poseidon2 tree, spent
/// with a zero-knowledge proof that checks the owner's EIP-712 signature. One pool per asset (custody pattern C). No
/// owner, no pause, no screener, no block list.
interface IOrreryShield {
    /// @notice Everything the proof commits to, in circuit public-input order.
    struct TxArgs {
        bytes proof;
        uint256 root;
        uint256[2] nullifiers;
        uint256[2] outCommitments;
        address asset;
        uint8 kind;
        uint256 withdrawAmount;
        address withdrawTo;
        uint256 fee;
        uint256 protocolFee;
        uint256 intentNullifier;
    }

    /// @notice Data the proof binds through `extDataHash` but does not read.
    struct ExtData {
        address relayer;
        bytes encryptedOutput0;
        bytes encryptedOutput1;
    }

    event AccountRegistered(address indexed account, uint256 npk, bytes viewKey);
    event Deposited(
        address indexed depositor,
        uint256 amount,
        uint256 fee,
        uint256 secretCommit,
        uint256 commitment,
        uint32 indexed leafIndex,
        bytes encryptedNote
    );
    event NewCommitment(uint256 commitment, uint32 indexed leafIndex, bytes encryptedNote);
    event NewNullifier(uint256 nullifier);
    event Transacted(
        uint8 kind, uint256 withdrawAmount, address indexed withdrawTo, uint256 fee, uint256 protocolFee, address relayer
    );
    event FeesFlushed(address indexed treasury, uint256 amount);

    error AlreadyRegistered();
    error BadKey();
    error BadAmount();
    error NotField();
    error NoteTooLarge();
    error TreeFull();
    error UnknownRoot();
    error NullifierSpent();
    error IntentUsed();
    error BadKind();
    error BadWithdraw();
    error WrongAsset();
    error FeeTooLow();
    error InvalidProof();
    error InexactTransfer();
    error NothingToFlush();

    function FIELD_SIZE() external view returns (uint256);
    function DEPTH() external view returns (uint256);
    function MAX_FEE_BPS() external view returns (uint16); // 100
    function verifier() external view returns (address);
    function asset() external view returns (address);
    function treasury() external view returns (address);
    function feeTiers() external view returns (address);
    function depositFeeBps() external view returns (uint16);
    function withdrawFeeBps() external view returns (uint16);
    function DOMAIN_SEPARATOR() external view returns (bytes32);

    function currentRoot() external view returns (uint256);
    function knownRoots(uint256 root) external view returns (bool);
    function nextLeafIndex() external view returns (uint32);
    function nullifierSpent(uint256 nullifier) external view returns (bool);
    function intentUsed(uint256 intentNullifier) external view returns (bool);
    function accruedFees() external view returns (uint256);
    function accountOf(address who) external view returns (uint256 npk, bytes memory viewKey);
    /// @notice Fee on a deposit of `amount` by `depositor`, and the smallest protocol fee a withdrawal of `amount` to
    /// `to` must carry, with the staker discount of each.
    function depositFee(address depositor, uint256 amount) external view returns (uint256);
    function withdrawFeeFloor(address to, uint256 amount) external view returns (uint256);
    function noteCommitment(uint256 amount, uint256 secretCommit) external view returns (uint256);
    function extDataHash(ExtData calldata ext) external pure returns (uint256);

    function register(uint256 npk, bytes calldata viewKey) external;
    /// @notice Pulls `amount`, takes the fee and inserts a note of `amount - fee` for `secretCommit` at once.
    function deposit(uint256 amount, uint256 secretCommit, bytes calldata encryptedNote) external returns (uint32 leafIndex);
    function transact(TxArgs calldata args, ExtData calldata ext) external;
    /// @notice Sends the fees taken so far to the treasury. Anyone.
    function flushFees() external returns (uint256 amount);
}
